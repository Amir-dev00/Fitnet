DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Only the browser request for index.html. DirectoryIndex must not loop.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteRule ^about\.html$ /about/ [R=301,L]
RewriteRule ^shop\.html$ /plans/ [R=301,L]
RewriteRule ^blog\.html$ /guides/ [R=301,L]
RewriteRule ^privacy\.html$ /privacy/ [R=301,L]
RewriteRule ^terms\.html$ /terms/ [R=301,L]

# Query string is kept because the substitution has no "?".
RewriteRule ^contact\.html$ /contact/ [R=301,L]

RewriteCond %{QUERY_STRING} (?:^|&)slug=start(?:&|$)
RewriteRule ^blog-post\.html$ /guides/start/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)slug=wallet(?:&|$)
RewriteRule ^blog-post\.html$ /guides/wallet/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)slug=booking(?:&|$)
RewriteRule ^blog-post\.html$ /guides/booking/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)slug=cancel(?:&|$)
RewriteRule ^blog-post\.html$ /guides/cancel/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)slug=events(?:&|$)
RewriteRule ^blog-post\.html$ /guides/events/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)slug=partners(?:&|$)
RewriteRule ^blog-post\.html$ /guides/partners/? [R=301,L]

RewriteRule ^blog-post\.html$ /guides/open/ [R=301,L]
